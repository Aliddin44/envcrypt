{
  "name": "@asliddin-muminov/envcrypt",
  "version": "1.0.0",
  "author": "Asliddin Muminov <asliddin4466@gmail.com>",
  "description": "Secure AES-256 .env file encryption CLI tool with argon2/scrypt support",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/envcrypt.ts",
    "start": "node dist/bin/envcrypt.js",
    "test": "node test/run.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "envcrypt": "dist/bin/envcrypt.js"
  },
  "type": "module",
  "keywords": [
    "env",
