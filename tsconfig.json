{
  "name": "envcrypt",
  "version": "1.0.0",
  "description": "🔐 AES-256 .env shifrlash CLI vositasi",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "envcrypt": "./bin/envcrypt.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/envcrypt.ts",
    "start": "node bin/envcrypt.js",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["env", "encrypt", "decrypt", "security", "cli", "aes-256", "argon2", "scrypt"],
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "tsx": "^4.0.0",
    "@types/node": "^20.8.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "Sizning ismingiz",
  "license": "MIT",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
